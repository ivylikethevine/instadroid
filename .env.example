IG_USERNAME=username
IG_PASSWORD=password

# --- Scraper timing --------------------------------------------------------
# Sleep between scrape runs, in hours (randomized within the range).
#POLL_MIN_HOURS=2.5
#POLL_MAX_HOURS=4.5
# Max screens to scroll through per run, and how many consecutive already-seen
# posts stop a run early.
#MAX_SCROLLS=25
#STOP_AFTER_SEEN=4
# How long the scroll swipe gesture itself takes, in seconds. Too fast flings
# past posts instead of scrolling; keep MAX below ~1.5.
#SCROLL_SWIPE_MIN=0.6
#SCROLL_SWIPE_MAX=1.0
# How long to pause idle between scrolls, in seconds.
#SCROLL_PAUSE_MIN=1.5
#SCROLL_PAUSE_MAX=4.0
# Screens in a row with no recognisable post before a run reopens the feed
# (once) and then stops early, instead of swiping through all of MAX_SCROLLS
# blind. A debug dump is saved each time. 0 disables.
#EMPTY_SCREEN_LIMIT=3
# After a transient device failure (adb offline, uiautomator server not
# starting, Instagram won't come to the foreground), retry after these many
# minutes (+ up to 50% jitter) instead of sleeping a full poll interval — one
# entry per retry. Login challenges never retry early. Empty disables.
#RETRY_DELAYS_MINUTES=2,5,15

# --- Media quality -----------------------------------------------------------
# Post images are captured as a screenshot crop (Instagram's feed offers no
# in-app download of another account's original photo), so quality is capped
# by the redroid display resolution below, then re-encoded at this JPEG
# quality (1-95).
#MEDIA_QUALITY=95
# Raising these makes crops sharper at the cost of slower container boot and
# more memory; =host GPU mode was tried and rejected on this host, see
# CLAUDE.md, so keep androidboot.redroid_gpu_mode=guest as-is.
#REDROID_WIDTH=1080
#REDROID_HEIGHT=2340
#REDROID_DPI=420

# --- Debug dumps -------------------------------------------------------------
# Days before a debug .xml/.jpg/.png in local/data/debug is deleted (checked
# at the end of every run; the newest 12 dump pairs are kept either way until
# they age out). Other files there, e.g. scratch *.sqlite databases, are never
# touched. 0 disables age-based pruning.
#DEBUG_RETAIN_DAYS=7

# --- Retention -----------------------------------------------------------
# Delete posts (and their media) older than this many days; 0 keeps forever.
#RETAIN_DAYS=60
# Total media+DB size cap in MB, enforced (oldest posts first) after RETAIN_DAYS;
# 0 disables. Worth setting once carousels are captured in full, since a single
# heavily-posting account can otherwise grow disk use unboundedly between runs.
#MEDIA_MAX_MB=0

# --- Permalinks -------------------------------------------------------------
# Extra share-sheet passes (on later scroll screens) after the first, and taps
# on the share button itself before giving up on one pass, before a post falls
# back to a hash-based id.
#PERMALINK_RETRIES=2
#SHARE_TAP_TRIES=2
# Seconds to poll the clipboard for the copied permalink.
#CLIPBOARD_TIMEOUT=6.0

# --- Carousel and video capture ---------------------------------------------
# Max carousel slides to capture per post (each extra slide costs a swipe +
# screenshot + re-dump, so this bounds how long a heavy carousel post takes).
#MAX_CAROUSEL_SLIDES=10
# Seconds to let a video/Reel's autoplay start and its audio-label overlay
# fade before the still is taken.
#VIDEO_SETTLE_SECONDS=1.5

# --- Avatars -----------------------------------------------------------------
# Days before an already-captured avatar is refreshed.
#AVATAR_REFRESH_DAYS=14

# --- Stories -----------------------------------------------------------------
# Max accounts' stories to open per run (each one is a real, visible view — see
# README's "Staying under the radar"). Only the story's current frame is
# captured, and only the Home feed's tray is used, not a full profile visit.
#MAX_STORIES_PER_RUN=10
# Hours before a captured story is deleted, regardless of RETAIN_DAYS — matches
# Instagram's own ~24h story expiry.
#STORY_RETAIN_HOURS=24

# --- Timing distribution / fingerprint consistency ---------------------------
# How poll-interval and in-session pause durations are drawn: "uniform" (flat
# random.uniform, the original behavior), "lognormal" (a heavier-tailed,
# human-like shape), or "daynight" (lognormal, but activity thins out overnight
# — see DAYNIGHT_QUIET_* below).
#TIME_DISTRIBUTION=uniform
# Local hours (in DEVICE_TIMEZONE) during which "daynight" widens its range,
# i.e. "asleep". End < start wraps past midnight.
#DAYNIGHT_QUIET_START=0
#DAYNIGHT_QUIET_END=6
# An IANA timezone (e.g. America/Los_Angeles) applied to the device itself by
# scripts/tune-android.sh (via `service call alarm`, applies immediately, no
# reboot) and used by scraper.py to compute "local" time for DAYNIGHT_QUIET_*.
# Empty by default — deliberately not applied unless you set it, since it
# should agree with wherever the account's network traffic actually appears to
# originate (there's no IP proxy/VPN support yet — see README's Roadmap — so a
# timezone that doesn't match this host's own egress may be a worse signal
# than leaving the device on its default GMT). Locale and mock GPS location
# were investigated for this same "fingerprint consistency" goal and are not
# implemented: locale changes didn't take effect without a system broadcast
# `adb shell` isn't permitted to send on this device, and `adb emu geo fix`
# (the standard GPS-mocking path) doesn't work on redroid's non-QEMU
# virtualization — both would need a materially different approach.
#DEVICE_TIMEZONE=

# --- Feed server -----------------------------------------------------------
# What FreshRSS or other feed readers should reach this server at.
#PUBLIC_URL=http://localhost:8000
# Loopback only by default; set to 0.0.0.0 to allow LAN access.
#FEED_HOST=127.0.0.1

# --- FreshRSS ----------------------------------------------------------------
# Subscribe with /opml (one import, every feed) rather than pasting ?user= URLs by hand — see
# README's FreshRSS section. The optional `freshrss` compose service (profile "freshrss") is one
# way to run a reader for this; run it, do its one-time setup, then set the two below.

# FreshRSS's own external "online cron" actualize URL, including its user=/token= — GETed after a
# scrape stores something new so it shows up immediately instead of on FreshRSS's own poll
# interval. Built from the token `cli/create-user.php --token ...` produces at setup time. Empty
# disables the ping entirely; any reader with an equivalent plain-GET refresh webhook works too.
#FRESHRSS_REFRESH_URL=http://127.0.0.1:8080/i/?c=feed&a=actualize&user=<name>&token=<token>
#FRESHRSS_REFRESH_TIMEOUT=10.0

# Only read by the freshrss compose service itself (profile "freshrss"), not by the app.
# Loopback only by default, matching FEED_HOST above; host networking otherwise gives it the LAN.
#FRESHRSS_LISTEN=127.0.0.1:8080
# Minutes for FreshRSS's own built-in poller; leave unset since the scraper pushes instead.
#FRESHRSS_CRON_MIN=
# Required for FreshRSS to be allowed to fetch this instance's feed at all — see docker-compose.yml.
#FRESHRSS_INTERNAL_HOST_ALLOWLIST=127.0.0.1:8000 localhost:8000
