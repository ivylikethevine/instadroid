IG_USERNAME=username
IG_PASSWORD=password

# --- Scraper timing --------------------------------------------------------
# Sleep between scrape runs, in hours (randomized within the range).
#POLL_MIN_HOURS=2.5
#POLL_MAX_HOURS=4.5
# Max screens to scroll through per run, and how many consecutive already-seen
# posts stop a run early.
#MAX_SCROLLS=25
#STOP_AFTER_SEEN=4
# How long the scroll swipe gesture itself takes, in seconds. Too fast flings
# past posts instead of scrolling; keep MAX below ~1.5.
#SCROLL_SWIPE_MIN=0.6
#SCROLL_SWIPE_MAX=1.0
# How long to pause idle between scrolls, in seconds.
#SCROLL_PAUSE_MIN=1.5
#SCROLL_PAUSE_MAX=4.0

# --- Media quality -----------------------------------------------------------
# Post images are captured as a screenshot crop (Instagram's feed offers no
# in-app download of another account's original photo), so quality is capped
# by the redroid display resolution below, then re-encoded at this JPEG
# quality (1-95).
#MEDIA_QUALITY=95
# Raising these makes crops sharper at the cost of slower container boot and
# more memory; =host GPU mode was tried and rejected on this host, see
# CLAUDE.md, so keep androidboot.redroid_gpu_mode=guest as-is.
#REDROID_WIDTH=1080
#REDROID_HEIGHT=2340
#REDROID_DPI=420

# --- Retention -----------------------------------------------------------
# Delete posts (and their media) older than this many days; 0 keeps forever.
#RETAIN_DAYS=60
# Total media+DB size cap in MB, enforced (oldest posts first) after RETAIN_DAYS;
# 0 disables. Worth setting once carousels are captured in full, since a single
# heavily-posting account can otherwise grow disk use unboundedly between runs.
#MEDIA_MAX_MB=0

# --- Permalinks -------------------------------------------------------------
# Extra share-sheet passes (on later scroll screens) after the first, and taps
# on the share button itself before giving up on one pass, before a post falls
# back to a hash-based id.
#PERMALINK_RETRIES=2
#SHARE_TAP_TRIES=2
# Seconds to poll the clipboard for the copied permalink.
#CLIPBOARD_TIMEOUT=6.0

# --- Carousel and video capture ---------------------------------------------
# Max carousel slides to capture per post (each extra slide costs a swipe +
# screenshot + re-dump, so this bounds how long a heavy carousel post takes).
#MAX_CAROUSEL_SLIDES=10
# Seconds to let a video/Reel's autoplay start and its audio-label overlay
# fade before the still is taken.
#VIDEO_SETTLE_SECONDS=1.5

# --- Avatars -----------------------------------------------------------------
# Days before an already-captured avatar is refreshed.
#AVATAR_REFRESH_DAYS=14

# --- Feed server -----------------------------------------------------------
# What FreshRSS or other feed readers should reach this server at.
#PUBLIC_URL=http://localhost:8000
# Loopback only by default; set to 0.0.0.0 to allow LAN access.
#FEED_HOST=127.0.0.1
