# Everything this project generates at runtime (databases, media, the redroid volume, logs, the dev
# venv and tool caches) lives under local/.
local/

# Claude Code: .claude/settings.json is shared and tracked; personal overrides,
# agent worktrees and host-specific agent notes stay local.
.claude/settings.local.json
.claude/worktrees/
CLAUDE.local.md

# npm installs of the pinned CI Markdown tools (.github/package.json)
node_modules/

# Python and build output
__pycache__/
*.pyc
*.egg-info/
build/
dist/
target/
output/
tmp/
temp/
.import_linter_cache/

# Local Jekyll builds of the site (root _config.yml); unanchored, so an old build under docs/ matches too.
_site/
.jekyll-cache/

# Secrets: never commit environment files, keys or certificates.
.env
.env.*
!.env.example
*.env
.envrc
.direnv/
secret/
secrets/
private/
keys/
*.key
*.pem
*.priv
*.pub
*.rsa
*.crt
*.cert
*.pfx

# Instagram APKs, and screenshots/images, which can hold real account content (fixtures are
# pseudonymized XML, never images).
*.apk
*.xapk
*.png
*.jpg
*.jpeg
*.bmp
*.psd
*.log

# Not used in this project; kept out so stray editor or tooling output isn't committed by accident.
*.js
*.ts
*.bat
*.cmd
*.ps
*.ps1
*.ps2
*.doc
*.docx
*.id
