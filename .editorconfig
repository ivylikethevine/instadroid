# https://editorconfig.org
# shfmt reads this file too: shell scripts get the [*] indent and shfmt's defaults otherwise.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# ruff format's indent (pyproject.toml).
[*.py]
indent_size = 4
